meta {
  name: Login (Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "loginId": "admin@example.com",
    "password": "Admin12345"
  }
}

vars:pre-request {
  baseUrl: http://localhost:5080/api/v1
}

script:post-response {
  if (res.body && res.body.session && res.body.session.accessToken) {
    bru.setEnvVar("adminToken", res.body.session.accessToken);
  }
}
