meta {
  name: Search Questions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/questions/search
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "subjectId": "00000000-0000-0000-0000-000000000000",
    "chapterIds": [],
    "source": "Platform",
    "bankIds": [],
    "filters": {
      "mode": "All"
    },
    "limit": 20
  }
}
